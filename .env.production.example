# ==============================================================================
# Billza Production Environment Variables (billza.xyz / api.billza.xyz)
# Copy this file to .env on your Dokploy production host before launching.
# ==============================================================================

# --- Domains ---
FRONTEND_DOMAIN=billza.xyz
API_DOMAIN=api.billza.xyz

# --- Django Security ---
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=generate-a-strong-random-64-character-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.billza.xyz,billza.xyz,www.billza.xyz,web,localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://billza.xyz,https://www.billza.xyz
CSRF_TRUSTED_ORIGINS=https://billza.xyz,https://www.billza.xyz,https://api.billza.xyz

# --- PostgreSQL Database ---
USE_POSTGRES=true
POSTGRES_DB=billza_db
POSTGRES_USER=billza_user
POSTGRES_PASSWORD=choose_a_strong_database_password_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://billza_user:choose_a_strong_database_password_2026@db:5432/billza_db

# --- Redis & Celery ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Migrations & Demo Seeding ---
RUN_MIGRATIONS=true
SEED_DEMO_DATA=false

# --- Frontend Build Arguments ---
VITE_API_BASE_URL=https://api.billza.xyz/api
VITE_FRONTEND_URL=https://billza.xyz
VITE_STELLAR_NETWORK=TESTNET

# --- Stellar Testnet & Soroban Smart Contracts ---
STELLAR_NETWORK=TESTNET
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# Testnet Asset SACs & Addresses
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYJLPU6QXNGB4BEVUNWZ3CWXB57BA2O3QI
BILLZA_CONTRACT_ID=CCOSNSVHGLYFMO72ICZY2Y7KZYQLZ77AADT4LIU6VL4XDRT2IY6IQMOG
BILLZA_PLATFORM_FEE_RECIPIENT=GA4KDGQIIXA7SQZB43AIK254XTSGYV3HBX4GAPKU3N2ECP76IX4U557Q
BILLZA_PLATFORM_FEE_BPS=0

# --- Email Notifications ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-smtp-api-key
DEFAULT_FROM_EMAIL=notifications@billza.xyz
REMINDER_CRON_SECRET=generate-a-strong-random-cron-secret-key-2026
