# ==============================================================================
# Billza Backend & Smart Contract Environment Configuration (Stellar Testnet)
# ==============================================================================

# --- Django Core Settings ---
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=billza-insecure-development-secret-key-change-in-production-64char
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
CORS_ALLOW_ALL_ORIGINS=True
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# --- Database Settings (PostgreSQL or SQLite fallback) ---
USE_POSTGRES=False
POSTGRES_DB=billza_db
POSTGRES_USER=billza_user
POSTGRES_PASSWORD=billza_secure_password_2026
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://billza_user:billza_secure_password_2026@db:5432/billza_db

# --- Redis & Celery Settings ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Stellar Testnet Configuration ---
STELLAR_NETWORK=TESTNET
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
# Testnet USDC SAC & Issuer
STELLAR_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
STELLAR_USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYJLPU6QXNGB4BEVUNWZ3CWXB57BA2O3QI

# --- Billza Soroban Smart Contract ---
BILLZA_CONTRACT_ID=
BILLZA_CONTRACT_ADMIN_SECRET=
BILLZA_PLATFORM_FEE_RECIPIENT=
BILLZA_PLATFORM_FEE_BPS=0

# --- Email & Reminder Settings ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=notifications@billza.app
REMINDER_CRON_SECRET=billza-cron-secret-key-2026
